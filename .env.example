# ─── Karmora environment variables ──────────────────────────────────
# Copy this to .env.local (Next.js) and scanner/.env (VPS worker)
# NEVER commit the real .env files.

# ─── Supabase ───────────────────────────────────────────────────────
# From: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # server-only, never exposed to browser

# ─── Stripe ─────────────────────────────────────────────────────────
# From: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Price IDs from: Products → your product → pricing
STRIPE_PRICE_ID_PRO=price_...

# ─── OpenAI ─────────────────────────────────────────────────────────
# Used by the scanner for lead scoring + opener generation
OPENAI_API_KEY=sk-...
OPENAI_MODEL_SCORING=gpt-4o-mini        # cheap, fast, plenty good for scoring
OPENAI_MODEL_OPENER=gpt-4o              # worth the extra cents for opener quality

# ─── Webshare (rotating proxies) ────────────────────────────────────
# Free tier: webshare.io → 10 free proxies after signup
# Download proxy list as USER:PASS@HOST:PORT format
WEBSHARE_PROXY_LIST=user:pass@1.2.3.4:8080,user:pass@5.6.7.8:8080
# Set to "false" to disable proxies during local dev
USE_PROXIES=true

# ─── SerpAPI (Google Rank Detection) ────────────────────────────────
# Free tier: 100 searches/month at serpapi.com
# Only used for Week 2 Session 7 — leave blank until then
SERPAPI_KEY=

# ─── Telegram alerts (reuse your Xylo setup) ────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── App config ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# User agent for Reddit requests — be honest, it reduces ban risk
REDDIT_USER_AGENT=karmora/0.1 (customer discovery tool; contact julan@karmora.app)
